@using SoporteTecnico.EN.Enumeraciones
@model SoporteTecnico.Web.ViewModels.Tickets.TicketDetailsViewModel
@{
    var t = Model.Ticket;
    ViewData["Title"] = $"Ticket #{t.IdTicket}";
    var hayAcciones = Model.PuedeAsignar || Model.PuedeIniciar || Model.PuedeResolver || Model.PuedeCerrar;

    var pasos = new[] { EstadoTicket.Pendiente, EstadoTicket.EnProceso, EstadoTicket.Resuelto, EstadoTicket.Cerrado };
    var pasoActual = Array.IndexOf(pasos, t.Estado) + 1;

    string NombreEstado(EstadoTicket e) => e switch
    {
        EstadoTicket.Pendiente => "Pendiente",
        EstadoTicket.EnProceso => "En proceso",
        EstadoTicket.Resuelto => "Resuelto",
        EstadoTicket.Cerrado => "Cerrado",
        _ => e.ToString()
    };

    string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length == 1
            ? partes[0].Substring(0, 1).ToUpper()
            : (partes[0].Substring(0, 1) + partes[1].Substring(0, 1)).ToUpper();
    }
}

<div class="mb-3">
    <a asp-action="Index" class="back-link text-decoration-none">&larr; Volver a tickets</a>
</div>

<div class="page-header">
    <div>
        <h1>@t.Titulo</h1>
        <p class="subtitulo">Ticket #@t.IdTicket &middot; @t.Categoria?.Nombre &middot; Prioridad @t.Prioridad.ToString().ToLower()</p>
    </div>
</div>

<div class="card-app mb-3">
    <div class="stepper">
        @for (var i = 0; i < pasos.Length; i++)
        {
            var n = i + 1;
            var clase = n < pasoActual ? "done" : (n == pasoActual ? "current" : "");
            <div class="step @clase">
                <span class="step-dot">@n</span>
                <span class="step-label">@NombreEstado(pasos[i])</span>
            </div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">

        <div class="card-app mb-3">
            <div class="p-4">
                <h2 class="h6 mb-2">Descripción</h2>
                <p class="small mb-0" style="white-space: pre-line">@t.Descripcion</p>

                @if (!string.IsNullOrWhiteSpace(t.Solucion))
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <h2 class="h6 fw-bold">Solución aplicada</h2>
                        <div style="white-space: pre-line">@t.Solucion</div>
                    </div>
                }
            </div>
        </div>

        <div class="card-app">
            <div class="p-4">
                <h2 class="h6 mb-3">Comentarios</h2>

                @if (!Model.Comentarios.Any())
                {
                    <p class="text-muted small">Todavía no hay comentarios.</p>
                }
                else
                {
                    foreach (var c in Model.Comentarios)
                    {
                        <div class="comment">
                            <span class="comment-avatar">@Iniciales(c.Usuario?.Nombre)</span>
                            <div>
                                <div>
                                    <span class="autor">@c.Usuario?.Nombre</span>
                                    <span class="fecha">@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="texto">@c.Contenido</div>
                            </div>
                        </div>
                    }
                }

                @if (Model.PuedeComentar)
                {
                    <form asp-action="Comentar" asp-route-id="@t.IdTicket" method="post" class="mt-3">
                        <label class="form-label" for="contenido">Agregar comentario</label>
                        <textarea name="contenido" id="contenido" class="form-control mb-2" rows="3" maxlength="2000" required></textarea>
                        <button type="submit" class="btn btn-primary">Comentar</button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">El ticket está cerrado; ya no admite comentarios.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="card-app mb-3">
            <div class="p-4">
                <h2 class="h6 mb-2">Detalles</h2>
                <div class="detail-row"><span class="k">Solicitante</span><span class="v">@t.Solicitante?.Nombre</span></div>
                <div class="detail-row"><span class="k">Técnico</span><span class="v">@(t.Tecnico?.Nombre ?? "Sin asignar")</span></div>
                <div class="detail-row"><span class="k">Categoría</span><span class="v">@t.Categoria?.Nombre</span></div>
                <div class="detail-row"><span class="k">Prioridad</span><span class="v"><partial name="_PrioridadBadge" model="t.Prioridad" /></span></div>
                <div class="detail-row"><span class="k">Creado</span><span class="v">@t.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                @if (t.FechaCierre.HasValue)
                {
                    <div class="detail-row"><span class="k">Cerrado</span><span class="v">@t.FechaCierre.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
                }
            </div>
        </div>

        @if (hayAcciones)
        {
            <div class="card-app mb-3">
                <div class="p-4">
                    @if (Model.PuedeAsignar)
                    {
                        <h2 class="h6 mb-3">Asignar ticket</h2>
                        <form asp-action="Asignar" asp-route-id="@t.IdTicket" method="post">
                            @if (Model.Tecnicos.Any())
                            {
                                <label class="form-label" for="idTecnico">Técnico</label>
                                <select name="idTecnico" id="idTecnico" class="form-select mb-2" required>
                                    <option value="">Seleccione un técnico</option>
                                    @foreach (var tec in Model.Tecnicos)
                                    {
                                        <option value="@tec.IdUsuario">@tec.Nombre</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary w-100">Asignar</button>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No hay técnicos activos disponibles.</p>
                            }
                        </form>
                    }

                    @if (Model.PuedeIniciar)
                    {
                        <h2 class="h6 mb-3">Atender ticket</h2>
                        <form asp-action="Iniciar" asp-route-id="@t.IdTicket" method="post">
                            <button type="submit" class="btn btn-primary w-100">Iniciar trabajo</button>
                        </form>
                    }

                    @if (Model.PuedeResolver)
                    {
                        <h2 class="h6 mb-3">Resolver ticket</h2>
                        <form asp-action="Resolver" asp-route-id="@t.IdTicket" method="post">
                            <label class="form-label" for="solucion">Solución aplicada</label>
                            <textarea name="solucion" id="solucion" class="form-control mb-2" rows="4" maxlength="2000" required></textarea>
                            <button type="submit" class="btn btn-success w-100">Marcar como resuelto</button>
                        </form>
                    }

                    @if (Model.PuedeCerrar)
                    {
                        <h2 class="h6 mb-3 @(Model.PuedeAsignar || Model.PuedeIniciar || Model.PuedeResolver ? "mt-4" : "")">Cerrar ticket</h2>
                        <form asp-action="Cerrar" asp-route-id="@t.IdTicket" method="post"
                              onsubmit="return confirm('¿Cerrar el ticket? Ya no se podrá comentar.');">
                            <button type="submit" class="btn btn-outline-secondary w-100">Cerrar ticket</button>
                        </form>
                    }
                </div>
            </div>
        }

        <div class="card-app">
            <div class="p-4">
                <h2 class="h6 mb-3">Historial</h2>
                @if (!Model.Historial.Any())
                {
                    <p class="text-muted small mb-0">Sin movimientos.</p>
                }
                else
                {
                    foreach (var h in Model.Historial)
                    {
                        <div class="timeline-item">
                            <div class="t">
                                @if (h.EstadoAnterior == null)
                                {
                                    <span>Ticket creado</span>
                                }
                                else
                                {
                                    <span>@NombreEstado((EstadoTicket)h.EstadoAnterior.Value) &rarr; @NombreEstado((EstadoTicket)h.EstadoNuevo)</span>
                                }
                            </div>
                            <div class="m">@h.Usuario?.Nombre &middot; @h.FechaCambio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>