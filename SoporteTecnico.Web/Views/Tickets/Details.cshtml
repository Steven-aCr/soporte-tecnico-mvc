@using SoporteTecnico.EN.Enumeraciones
@model SoporteTecnico.Web.ViewModels.Tickets.TicketDetailsViewModel
@{
    var t = Model.Ticket;
    ViewData["Title"] = $"Ticket #{t.IdTicket}";
    var hayAcciones = Model.PuedeAsignar || Model.PuedeIniciar || Model.PuedeResolver || Model.PuedeCerrar;

    string NombreEstado(EstadoTicket e) => e switch
    {
        EstadoTicket.Pendiente => "Pendiente",
        EstadoTicket.EnProceso => "En proceso",
        EstadoTicket.Resuelto => "Resuelto",
        EstadoTicket.Cerrado => "Cerrado",
        _ => e.ToString()
    };
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none">&larr; Volver a tickets</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">

        <div class="card card-app mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <div class="text-muted small">Ticket #@t.IdTicket</div>
                        <h1 class="h4 fw-bold mb-0">@t.Titulo</h1>
                    </div>
                    <div class="d-flex gap-2">
                        <partial name="_PrioridadBadge" model="t.Prioridad" />
                        <partial name="_EstadoBadge" model="t.Estado" />
                    </div>
                </div>

                <h2 class="h6 text-muted">Descripción</h2>
                <p style="white-space: pre-line">@t.Descripcion</p>

                @if (!string.IsNullOrWhiteSpace(t.Solucion))
                {
                    <div class="alert alert-success mb-0">
                        <h2 class="h6 fw-bold">Solución</h2>
                        <div style="white-space: pre-line">@t.Solucion</div>
                    </div>
                }
            </div>
        </div>

        <div class="card card-app">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-3">Comentarios</h2>

                @if (!Model.Comentarios.Any())
                {
                    <p class="text-muted">Todavía no hay comentarios.</p>
                }
                else
                {
                    foreach (var c in Model.Comentarios)
                    {
                        <div class="border rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@c.Usuario?.Nombre</span>
                                <span class="text-muted">@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div style="white-space: pre-line">@c.Contenido</div>
                        </div>
                    }
                }

                @if (Model.PuedeComentar)
                {
                    <form asp-action="Comentar" asp-route-id="@t.IdTicket" method="post" class="mt-3">
                        <div class="mb-2">
                            <textarea name="contenido" class="form-control" rows="3" maxlength="2000"
                                      placeholder="Escribe un comentario..." required></textarea>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-sm">Comentar</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">El ticket está cerrado; ya no admite comentarios.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="card card-app mb-4">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-3">Información</h2>
                <dl class="mb-0 small">
                    <dt class="text-muted fw-normal">Solicitante</dt>
                    <dd>@t.Solicitante?.Nombre</dd>
                    <dt class="text-muted fw-normal">Técnico</dt>
                    <dd>@(t.Tecnico?.Nombre ?? "Sin asignar")</dd>
                    <dt class="text-muted fw-normal">Categoría</dt>
                    <dd>@t.Categoria?.Nombre</dd>
                    <dt class="text-muted fw-normal">Creado</dt>
                    <dd>@t.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    @if (t.FechaCierre.HasValue)
                    {
                        <dt class="text-muted fw-normal">Cerrado</dt>
                        <dd class="mb-0">@t.FechaCierre.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (hayAcciones)
        {
            <div class="card card-app mb-4">
                <div class="card-body p-4">
                    <h2 class="h6 fw-bold mb-3">Acciones</h2>

                    @if (Model.PuedeAsignar)
                    {
                        <form asp-action="Asignar" asp-route-id="@t.IdTicket" method="post">
                            @if (Model.Tecnicos.Any())
                            {
                                <label class="form-label small" for="idTecnico">Asignar técnico</label>
                                <select name="idTecnico" id="idTecnico" class="form-select mb-2" required>
                                    <option value="">Seleccione un técnico</option>
                                    @foreach (var tec in Model.Tecnicos)
                                    {
                                        <option value="@tec.IdUsuario">@tec.Nombre</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary w-100">Asignar</button>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No hay técnicos activos disponibles.</p>
                            }
                        </form>
                    }

                    @if (Model.PuedeIniciar)
                    {
                        <form asp-action="Iniciar" asp-route-id="@t.IdTicket" method="post">
                            <button type="submit" class="btn btn-primary w-100">Iniciar trabajo</button>
                        </form>
                    }

                    @if (Model.PuedeResolver)
                    {
                        <form asp-action="Resolver" asp-route-id="@t.IdTicket" method="post">
                            <label class="form-label small" for="solucion">Solución</label>
                            <textarea name="solucion" id="solucion" class="form-control mb-2" rows="4"
                                      maxlength="2000" required></textarea>
                            <button type="submit" class="btn btn-success w-100">Marcar como resuelto</button>
                        </form>
                    }

                    @if (Model.PuedeCerrar)
                    {
                        <form asp-action="Cerrar" asp-route-id="@t.IdTicket" method="post"
                              onsubmit="return confirm('¿Cerrar el ticket? Ya no se podrá comentar.');">
                            <button type="submit" class="btn btn-secondary w-100">Cerrar ticket</button>
                        </form>
                    }
                </div>
            </div>
        }

        <div class="card card-app">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-3">Historial de estados</h2>
                @if (!Model.Historial.Any())
                {
                    <p class="text-muted small mb-0">Sin movimientos.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var h in Model.Historial)
                        {
                            <li class="mb-3">
                                <div class="fw-semibold">
                                    @if (h.EstadoAnterior == null)
                                    {
                                        <span>Ticket creado</span>
                                    }
                                    else
                                    {
                                        <span>@NombreEstado((EstadoTicket)h.EstadoAnterior.Value) &rarr; @NombreEstado((EstadoTicket)h.EstadoNuevo)</span>
                                    }
                                </div>
                                <div class="text-muted">
                                    @h.Usuario?.Nombre &middot; @h.FechaCambio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>