@using SoporteTecnico.EN.Enumeraciones
@model PrioridadTicket
@{
    var (clase, texto) = Model switch
    {
        PrioridadTicket.Alta => ("prioridad-alta", "Alta"),
        PrioridadTicket.Media => ("prioridad-media", "Media"),
        PrioridadTicket.Baja => ("prioridad-baja", "Baja"),
        _ => ("prioridad-baja", Model.ToString())
    };
}
<span class="badge-estado @clase">@texto</span>