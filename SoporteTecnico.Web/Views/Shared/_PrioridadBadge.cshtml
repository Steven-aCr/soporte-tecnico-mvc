@using SoporteTecnico.EN.Enumeraciones
@model PrioridadTicket
@{
    var (clase, texto) = Model switch
    {
        PrioridadTicket.Alta => ("prio-alta", "Alta"),
        PrioridadTicket.Media => ("prio-media", "Media"),
        PrioridadTicket.Baja => ("prio-baja", "Baja"),
        _ => ("prio-media", Model.ToString())
    };
}
<span class="prio @clase">@texto</span>