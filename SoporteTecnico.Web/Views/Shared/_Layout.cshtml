@{
    var nombreUsuario = User.Identity?.Name ?? string.Empty;
    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var autenticado = User.Identity?.IsAuthenticated == true;
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Activo(string c) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Soporte Técnico</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        @if (autenticado)
        {
            <aside class="sidebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round">
                            <path d="M4 5h8M4 8h8M4 11h5" />
                        </svg>
                    </span>
                    Soporte
                </a>

                <nav class="sidebar-nav">
                    <a class="sidebar-link @Activo("Home")" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a class="sidebar-link @Activo("Tickets")" asp-controller="Tickets" asp-action="Index">Tickets</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="sidebar-link @Activo("Categorias")" asp-controller="Categorias" asp-action="Index">Categorías</a>
                        <a class="sidebar-link @Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                    }
                </nav>

                <div class="sidebar-user">
                    <div>
                        <div class="nombre">@nombreUsuario</div>
                        <div class="rol">@rolUsuario</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Cerrar sesión</button>
                    </form>
                </div>
            </aside>
        }

        <main role="main" class="app-main">
            <div class="app-content">
                <partial name="_Mensajes" />
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>