@using SoporteTecnico.EN.Enumeraciones
@model EstadoTicket
@{
    var (clase, texto) = Model switch
    {
        EstadoTicket.Pendiente => ("estado-pendiente", "Pendiente"),
        EstadoTicket.EnProceso => ("estado-enproceso", "En proceso"),
        EstadoTicket.Resuelto => ("estado-resuelto", "Resuelto"),
        EstadoTicket.Cerrado => ("estado-cerrado", "Cerrado"),
        _ => ("estado-cerrado", Model.ToString())
    };
}
<span class="estado @clase">@texto</span>