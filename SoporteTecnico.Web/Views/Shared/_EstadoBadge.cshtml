@using SoporteTecnico.EN.Enumeraciones
@model EstadoTicket
@{
    var (clase, texto) = Model switch
    {
        EstadoTicket.Pendiente => ("bg-warning text-dark", "Pendiente"),
        EstadoTicket.EnProceso => ("bg-primary", "En proceso"),
        EstadoTicket.Resuelto => ("bg-success", "Resuelto"),
        EstadoTicket.Cerrado => ("bg-secondary", "Cerrado"),
        _ => ("bg-light text-dark", Model.ToString())
    };
}
<span class="badge rounded-pill @clase">@texto</span>