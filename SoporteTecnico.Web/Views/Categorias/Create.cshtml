@model SoporteTecnico.Web.ViewModels.Categorias.CategoriaFormViewModel
@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-app">
            <div class="card-body p-4 p-md-5">
                <h1 class="h4 fw-bold mb-4">Nueva categoría</h1>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}