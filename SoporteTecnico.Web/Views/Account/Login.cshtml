@model SoporteTecnico.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
}

<div class="auth-split">
    <section class="auth-brand-panel">
        <div class="brand-line">
            <span class="brand-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0f6b75" stroke-width="1.6" stroke-linecap="round">
                    <path d="M4 5h8M4 8h8M4 11h5" />
                </svg>
            </span>
            Soporte Técnico
        </div>

        <div>
            <h2>Cada solicitud, atendida a tiempo.</h2>
            <p>Crea tickets, asigna técnicos y sigue el estado de cada caso desde un solo lugar.</p>
        </div>

        <div class="auth-links">
            <span>Seguimiento por estado</span>
            <span>Historial completo</span>
            <span>Comentarios por ticket</span>
        </div>
    </section>

    <section class="auth-form-panel">
        <div class="auth-form-box">
            <h1>Bienvenida de nuevo</h1>
            <p class="text-muted small mb-4">Ingresa con tu correo institucional.</p>

            <partial name="_Mensajes" />

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Entrar</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}