@model SoporteTecnico.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-wrapper">
    <div class="card card-app auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="brand-badge mb-3">ST</div>
                <h1 class="h4 fw-bold mb-1">Soporte Técnico</h1>
                <p class="text-muted mb-0">Inicia sesión para continuar</p>
            </div>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Correo" class="form-control" placeholder="correo@ejemplo.com" autocomplete="username" autofocus />
                    <label asp-for="Correo"></label>
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">Entrar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}