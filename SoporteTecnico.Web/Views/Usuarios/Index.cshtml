@model List<SoporteTecnico.EN.Entidades.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var idActual = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 fw-bold mb-0">Usuarios</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo usuario</a>
</div>

<div class="card card-app">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted py-5">No hay usuarios registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var esActual = u.IdUsuario.ToString() == idActual;
                        <tr>
                            <td class="fw-semibold">@u.Nombre @if (esActual) { <span class="text-muted fw-normal small">(tú)</span> }</td>
                            <td>@u.Correo</td>
                            <td>@u.Rol?.Nombre</td>
                            <td>
                                @if (u.Activo)
                                {
                                    <span class="badge rounded-pill bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@u.IdUsuario">Editar</a>
                                @if (!esActual)
                                {
                                    if (u.Activo)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@u.IdUsuario" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Desactivar este usuario?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Desactivar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivar" asp-route-id="@u.IdUsuario" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-success btn-sm">Reactivar</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>